# Sharathi backend environment variables
# Copy this file to backend/.env and fill in your own values.

# Server port (the Vite dev proxy in frontend/vite.config.js expects 3001)
PORT=3000

# AI provider (OpenAI, used by src/services/aiAgent.js)
OPENAI_API_KEY=your_openai_api_key_here

# Meta Graph API (Facebook Messenger)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_webhook_verify_token_here
# Optional: override the OAuth redirect URI (default: <host>/facebook-callback)
# META_REDIRECT_URI=https://your-domain.example/facebook-callback
# Optional: static fallback Page token, used when no Page has been connected via OAuth
# PAGE_ACCESS_TOKEN=your_facebook_page_access_token
